        <mxCell id="KnKG3BYbRgJ7DP3B1gYY-4" value="Передает&lt;div&gt;пациенту&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="KnKG3BYbRgJ7DP3B1gYY-3" vertex="1" connectable="0">
          <mxGeometry x="-0.6132" y="-1" relative="1" as="geometry">
