        <mxCell id="S8diC4WnfU4uqMuqSpFN-4" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Добавляет информацию:&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- записывает новые жалобы пациента&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- записывает диагноз&amp;nbsp;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- назначает лечение&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- снова назначает дату следующего приема&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="S8diC4WnfU4uqMuqSpFN-3" vertex="1">
