        <mxCell id="SZulnQIUO0TVWphl2Lw0-2" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- ФИО пациента&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;+ № Договора&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- мобильный номер&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- email&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- дата рождения&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- описание жалоб&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- выбор ФИО врача&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- Дата и время приема&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- Предварительная стоимость услуги&lt;/div&gt;&lt;div style=&quot;&quot;&gt;- Кабинет&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;+ опции(прописка, аллергии, место работы/учебы)&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
