        <mxCell id="k-T06G5REp3ztXCYyugb-4" value="&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;- ФИО пациента&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;+ № Договора&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;- мобильный номер&lt;/div&gt;&lt;div&gt;- email&lt;/div&gt;&lt;div&gt;- дата рождения&lt;/div&gt;&lt;div&gt;- Дата и время приема анализов&lt;/div&gt;&lt;div&gt;- Тип анализа&lt;/div&gt;&lt;div&gt;- Стоимость услуг&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp;+ опции(прописка, аллергии, место работы/учебы).&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Результаты лабораторных исследований&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="k-T06G5REp3ztXCYyugb-3" vertex="1">
